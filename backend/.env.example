# iFit API (FastAPI) settings. Copy to backend/.env and fill in real values.
# backend/.env is git-ignored; never commit it.

# Your Supabase project URL (Project Settings -> API), e.g. https://abcd1234.supabase.co
SUPABASE_URL=

# The browser-safe publishable key (sb_publishable_...) or legacy anon key.
# Never use the secret / service-role key here; the API refuses to start with it.
SUPABASE_PUBLISHABLE_KEY=

# Comma-separated frontend origins allowed to call the API from a browser.
# Add http://localhost:3001 if Next.js falls back to that port.
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Seconds to wait for Supabase before reporting it unavailable (optional).
SUPABASE_TIMEOUT_SECONDS=8
