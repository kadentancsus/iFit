# iFit frontend (Next.js) settings. Copy to frontend/.env.local and fill in.
# .env.local is git-ignored; never commit it. NEXT_PUBLIC_ values are sent to
# the browser, so only browser-safe values belong here.

# Same Supabase project as backend/.env (Project Settings -> API).
NEXT_PUBLIC_SUPABASE_URL=

# The publishable (sb_publishable_...) or legacy anon key. Never the secret key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Where the FastAPI backend runs.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
